<%- include('partials/header') %>
<% const p = c.progress; %>
<% const evm = c.analytics ? c.analytics.evm : null; %>
<div class="grid g4">
  <div class="card kpi"><div class="l">Planned Progress</div><div class="v"><%= p.planned_pct.toFixed(1) %> %</div><div class="s"><%= p.weighting %>-weighted duration</div></div>
  <div class="card kpi"><div class="l">Actual Progress</div><div class="v"><%= p.actual_pct.toFixed(1) %> %</div><div class="s">data date <%= p.data_date %></div></div>
  <div class="card kpi"><div class="l">Progress Variance</div><div class="v <%= p.variance_pct < 0 ? 'bad' : 'ok' %>"><%= (p.variance_pct >= 0 ? '+' : '') + p.variance_pct.toFixed(1) %> pts</div><div class="s">performance index <%= p.performance_index !== null ? p.performance_index : '–' %></div></div>
  <div class="card kpi"><div class="l">Working Days Elapsed</div><div class="v"><%= p.elapsed_working_days %></div><div class="s">of baseline schedule</div></div>
</div>

<% if (evm) { %>
<!-- Earned Value Management (EVM) Metrics Row -->
<div class="grid g4" style="margin-top:10px">
  <div class="card kpi">
    <div class="l">Planned Value (PV)</div>
    <div class="v" style="font-size:20px">₹<%= evm.planned_value.toLocaleString() %></div>
    <div class="s">Budget (BAC): ₹<%= evm.budget_at_completion.toLocaleString() %></div>
  </div>
  <div class="card kpi">
    <div class="l">Earned Value (EV)</div>
    <div class="v" style="font-size:20px;color:var(--blue)">₹<%= evm.earned_value.toLocaleString() %></div>
    <div class="s">SV: <b class="<%= evm.schedule_variance >= 0 ? 'ok' : 'bad' %>"><%= evm.schedule_variance >= 0 ? '+' : '' %>₹<%= evm.schedule_variance.toLocaleString() %></b></div>
  </div>
  <div class="card kpi">
    <div class="l">Actual Cost (AC)</div>
    <div class="v" style="font-size:20px">₹<%= evm.actual_cost.toLocaleString() %></div>
    <div class="s">CV: <b class="<%= evm.cost_variance >= 0 ? 'ok' : 'bad' %>"><%= evm.cost_variance >= 0 ? '+' : '' %>₹<%= evm.cost_variance.toLocaleString() %></b></div>
  </div>
  <div class="card kpi">
    <div class="l">SPI / CPI</div>
    <div class="v" style="font-size:20px"><%= evm.spi.toFixed(2) %> / <%= evm.cpi.toFixed(2) %></div>
    <div class="s"><%= evm.schedule_status %> · <%= evm.cost_status %></div>
  </div>
</div>
<% } %>

<h2>S-curve (Planned Baseline vs Forecast Adapted)</h2>
<div class="card">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;flex-wrap:wrap;gap:8px">
    <div style="font-size:12px;color:var(--muted)">Cumulative percentage of project progress over the working-day schedule horizon.</div>
    <div style="display:flex;gap:14px;font-size:12px">
      <span style="color:#1d4e89"><b>—</b> Planned (baseline)</span>
      <span style="color:#fb8c00"><b>---</b> Forecast (adapted)</span>
      <span style="color:#d50000"><b>●</b> Actual (<%= p.actual_pct.toFixed(1) %>%)</span>
    </div>
  </div>
  <div id="scurve" style="border:1px solid #e2e8f0;border-radius:2px;overflow:hidden">
    <%- generateFigureSvg('s_curve', c, gantt) %>
  </div>
</div>

<% if (p.floor_progress && p.floor_progress.length > 0) { %>
<h2>Floor-wise Progress Breakdown (<%= c.project && c.project.building_config && c.project.building_config.config_label ? c.project.building_config.config_label : 'Building Levels' %>)</h2>
<div class="scroll">
  <table>
    <thead>
      <tr>
        <th>Level / Floor</th>
        <th class="num">Total Tasks</th>
        <th class="num">Completed</th>
        <th class="num">In Progress</th>
        <th class="num">Critical</th>
        <th class="num">Planned %</th>
        <th class="num">Actual %</th>
        <th class="num">Variance</th>
      </tr>
    </thead>
    <tbody>
      <% p.floor_progress.forEach(function(f) { %>
      <tr>
        <td><b class="chip" style="font-size:11px"><%= f.floor %></b></td>
        <td class="num"><%= f.total_activities %></td>
        <td class="num"><%= f.completed_activities %></td>
        <td class="num"><%= f.in_progress_activities %></td>
        <td class="num <%= f.critical_activities > 0 ? 'bad' : '' %>"><%= f.critical_activities %></td>
        <td class="num"><%= f.planned_pct.toFixed(1) %> %</td>
        <td class="num"><%= f.actual_pct.toFixed(1) %> %</td>
        <td class="num <%= f.variance_pct < 0 ? 'bad' : 'ok' %>"><%= (f.variance_pct >= 0 ? '+' : '') + f.variance_pct.toFixed(1) %> pts</td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% } %>

<h2>Activities in progress or behind plan</h2>
<div class="scroll">
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Activity</th>
        <th class="num">Planned %</th>
        <th class="num">Actual %</th>
        <th class="num">Variance</th>
      </tr>
    </thead>
    <tbody>
      <% const filteredActs = (p.activities || []).filter(a => a.planned_pct > 0 || a.actual_pct > 0).sort((a,b) => a.variance_pct - b.variance_pct); %>
      <% if (filteredActs.length > 0) { %>
        <% filteredActs.forEach(function(a) { %>
        <tr>
          <td class="mono"><b><%= a.activity_id %></b></td>
          <td><%= a.name %></td>
          <td class="num"><%= a.planned_pct %> %</td>
          <td class="num"><%= a.actual_pct %> %</td>
          <td class="num <%= a.variance_pct < 0 ? 'bad' : 'ok' %>"><%= (a.variance_pct >= 0 ? '+' : '') + a.variance_pct.toFixed(1) %> pts</td>
        </tr>
        <% }); %>
      <% } else { %>
        <tr><td colspan="5" style="text-align:center;color:var(--muted);padding:14px">All activities on schedule or not yet started</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<p class="note"><a href="/export/progress.csv?<%= query %>">Export CSV</a></p>
<%- include('partials/footer') %>
